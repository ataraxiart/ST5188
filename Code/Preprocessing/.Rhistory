popx = c(rep(x, 10), x[sam])
popy = c(rep(y, 10), y[sam])
mu_y = mean(popy)
mu_x = mean(popx)
R = mu_y/mu_x
# next, simulate a dataset of size 12 offices from the
# population and compute the sample ratio. The x and y values of this
# dataset are given in samx and samy.
sam2 = sample(c(1:123),12,replace=FALSE)
samx = popx[sam2]
samy = popy[sam2]
samr = mean(samy)/mean(samx)
sam_mu_y = samr * mu_x
z[i] = mu_y - sam_mu_y
}
# to compute 95% confidence intervals, we remove the top and bottom 2.5% of the bootstrap values.
# For I = 1000, that means the largest and smallest 25 values.
# The sort command arranges the entries of a vector in increasing order.
sz = sort(z)
lower = y_hat + (sz[25] + sz[26])/2
upper = y_hat + (sz[975] + sz[976])/2
c(lower,upper)
